# Store Management System - Backend Configuration Template
APP_NAME="Store Management System API"
APP_VERSION="1.0.0"
DEBUG="False"
ENVIRONMENT="development"
SEED_DEMO_DATA="False"
ENABLE_PUBLIC_REGISTRATION="False"
ENABLE_PROTOTYPE_ROUTERS="False"

HOST="127.0.0.1"
PORT=8000

DB_HOST="localhost"
DB_PORT=3306
DB_NAME="store_management"
DB_USER="root"
DB_PASSWORD="your_private_database_password"

SECRET_KEY="your_private_random_secret_of_at_least_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated, explicit frontend origins. Wildcards are rejected.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
